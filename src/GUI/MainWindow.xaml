<Window x:Class="GUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:GUI"
        xmlns:md="clr-namespace:PotatoAgent.Markdown;assembly=PotatoAgent.Markdown"
        mc:Ignorable="d"
        Title="potatoAgent"
        Height="680" Width="1240"
        MinHeight="420" MinWidth="900"
        WindowStartupLocation="CenterScreen">

    <!--
        ============================================================================
        临时脚手架界面（throwaway scaffolding）
        ============================================================================
        这里刻意只用最朴素的控件，不做配色 / 动画 / 自定义模板 —— 视觉设计由 yancy 亲自重画。
        本文件里的所有内容都可以整个删掉：业务逻辑一行都不在这里，全在
        GUI.ViewModels.ChatViewModel（DataContext 就是它）里。

        唯一的"挂钩"：齿轮按钮上的 Click="SettingsButton_Click"。
        重画时要么保留这个 Click 和 MainWindow.xaml.cs 里的同名方法，
        要么把它换成你自己的一条命令。

        ⚠️ 这里**不要**再放空的 <Style TargetType="TabControl" /> / <Style TargetType="TabItem" />。
        放了会把 App.xaml 的深色页签样式清掉 → 内容区变白底，而 Fluent 主题的按钮/输入框本身接近白色，
        结果就是"按钮看不见"。（2026-09-20 修复：实测白底 #FFFFFF + 白控件 #FFFFFF）
    -->

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ==================== 顶栏：产品名 + 齿轮（进设置页） ==================== -->
        <Grid Grid.Row="0" Margin="0,0,0,8">
            <TextBlock Text="potatoAgent" FontSize="16" VerticalAlignment="Center" HorizontalAlignment="Left" />
            <!-- &#x2699; = gear；AutomationId/Name 是给 UIA 测试和读屏软件用的，不是配色 -->
            <Button Content="&#x2699; Settings"
                    HorizontalAlignment="Right"
                    Padding="10,3"
                    Click="SettingsButton_Click"
                    ToolTip="Settings"
                    AutomationProperties.AutomationId="SettingsButton"
                    AutomationProperties.Name="Settings" />
        </Grid>

        <!-- ==================== 主区域：6 个页签 ==================== -->
        <TabControl Grid.Row="1" AutomationProperties.AutomationId="MainTabs">
            <TabItem Header="Chat">
                <!--
                    两列：左边是临时脚手架（会话列表 + 工作区条），右边是原样没动的聊天区。
                    这一层只是"把控件塞进去"，重画时连它一起删掉。
                -->
                <Grid Margin="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="270" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- ============================================================
                         TEMPORARY SCAFFOLD - yancy will redraw this. Keep it minimal.
                         左边这一栏整个都是临时的：只求"点得到"，没有设计、随时可整块删掉。
                         绑的是 ChatViewModel.Workspace / ChatViewModel.Sessions（DataContext 就是 ChatViewModel）。
                         所有可交互控件的配色都显式写成 {StaticResource ...}：Fluent 主题下控件默认接近纯白，
                         在深色面板里不写就是"白底白控件"。
                         ============================================================ -->
                    <ScrollViewer Grid.Column="0"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  AutomationProperties.AutomationId="ScaffoldPanel">
                        <StackPanel>

                            <!-- ========== 工作区条（WorkspaceViewModel） ========== -->
                            <TextBlock Text="WORKSPACE" FontWeight="SemiBold" Margin="0,0,0,4" />
                            <TextBlock Text="{Binding Workspace.CurrentName}"
                                       TextWrapping="Wrap"
                                       AutomationProperties.AutomationId="WorkspaceNameText"
                                       AutomationProperties.Name="Current workspace" />
                            <TextBlock Text="{Binding Workspace.CurrentPath}"
                                       Foreground="{StaticResource MutedForegroundBrush}"
                                       FontSize="11"
                                       TextWrapping="Wrap"
                                       Margin="0,2,0,0"
                                       AutomationProperties.AutomationId="WorkspacePathText"
                                       AutomationProperties.Name="Current workspace path" />
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <Button Content="Choose&#x2026;"
                                        Command="{Binding Workspace.ChooseCommand}"
                                        Padding="10,3"
                                        Background="{StaticResource ControlBrush}"
                                        Foreground="{StaticResource ForegroundBrush}"
                                        BorderBrush="{StaticResource PanelBorderBrush}"
                                        ToolTip="Pick a workspace folder"
                                        AutomationProperties.AutomationId="ChooseWorkspaceButton"
                                        AutomationProperties.Name="Choose workspace" />
                                <Button Content="Clear"
                                        Command="{Binding Workspace.ClearCommand}"
                                        Margin="6,0,0,0" Padding="10,3"
                                        Background="{StaticResource ControlBrush}"
                                        Foreground="{StaticResource ForegroundBrush}"
                                        BorderBrush="{StaticResource PanelBorderBrush}"
                                        ToolTip="Clear the current workspace"
                                        AutomationProperties.AutomationId="ClearWorkspaceButton"
                                        AutomationProperties.Name="Clear workspace" />
                            </StackPanel>
                            <TextBlock Text="Recent" Foreground="{StaticResource MutedForegroundBrush}" Margin="0,8,0,3" />
                            <ComboBox ItemsSource="{Binding Workspace.Recent}"
                                      DisplayMemberPath="Name"
                                      SelectionChanged="RecentWorkspace_SelectionChanged"
                                      Background="{StaticResource ControlBrush}"
                                      Foreground="{StaticResource ForegroundBrush}"
                                      BorderBrush="{StaticResource PanelBorderBrush}"
                                      ToolTip="Pick a recent folder to switch to it"
                                      AutomationProperties.AutomationId="RecentWorkspaceSelector"
                                      AutomationProperties.Name="Recent workspaces" />
                            <TextBlock Text="{Binding Workspace.StatusMessage}"
                                       Foreground="{StaticResource MutedForegroundBrush}"
                                       FontSize="11"
                                       TextWrapping="Wrap"
                                       Margin="0,4,0,0"
                                       AutomationProperties.AutomationId="WorkspaceStatusText"
                                       AutomationProperties.Name="Workspace status" />

                            <Separator Margin="0,10,0,10" />

                            <!-- ========== 会话列表（SessionListViewModel） ========== -->
                            <TextBlock Text="SESSIONS" FontWeight="SemiBold" Margin="0,0,0,4" />
                            <ListBox x:Name="SessionList"
                                     ItemsSource="{Binding Sessions.Sessions}"
                                     SelectedItem="{Binding Sessions.Current, Mode=OneWay}"
                                     SelectionChanged="SessionList_SelectionChanged"
                                     IsSynchronizedWithCurrentItem="True"
                                     Background="{StaticResource ControlBrush}"
                                     Foreground="{StaticResource ForegroundBrush}"
                                     BorderBrush="{StaticResource PanelBorderBrush}"
                                     MaxHeight="260"
                                     HorizontalContentAlignment="Stretch"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     AutomationProperties.AutomationId="SessionList"
                                     AutomationProperties.Name="Sessions">
                                <ListBox.Resources>
                                    <!-- 每一行也显式配色：不写就会用主题的浅色选中底 -->
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Background" Value="Transparent" />
                                        <Setter Property="Foreground" Value="{StaticResource ForegroundBrush}" />
                                        <Setter Property="Padding" Value="4,3" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <Border x:Name="RowRoot"
                                                            Background="{TemplateBinding Background}"
                                                            BorderBrush="Transparent"
                                                            BorderThickness="3,0,0,0"
                                                            Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter />
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="RowRoot" Property="Background" Value="{StaticResource HoverBrush}" />
                                                        </Trigger>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter TargetName="RowRoot" Property="Background" Value="{StaticResource SurfaceBrush}" />
                                                            <Setter TargetName="RowRoot" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.Resources>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel>
                                            <!-- Title 双向可写：在这个框里改 + 点 Rename 才落库 -->
                                            <TextBox Text="{Binding Title, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     Background="{StaticResource ControlBrush}"
                                                     Foreground="{StaticResource ForegroundBrush}"
                                                     BorderBrush="{StaticResource PanelBorderBrush}"
                                                     CaretBrush="{StaticResource ForegroundBrush}"
                                                     Padding="3,2"
                                                     AutomationProperties.AutomationId="SessionTitleBox"
                                                     AutomationProperties.Name="Session title" />
                                            <TextBlock Text="{Binding Subtitle}"
                                                       Foreground="{StaticResource MutedForegroundBrush}"
                                                       FontSize="11"
                                                       TextTrimming="CharacterEllipsis"
                                                       Margin="1,2,0,0" />
                                            <!-- 选中态由 SelectCommand 那边的 Refresh 负责（IsCurrent），这里不额外画 -->
                                            <Button Content="Rename"
                                                    Command="{Binding CommitRenameCommand}"
                                                    HorizontalAlignment="Right"
                                                    Margin="0,3,0,0" Padding="8,2"
                                                    Background="{StaticResource ControlBrush}"
                                                    Foreground="{StaticResource ForegroundBrush}"
                                                    BorderBrush="{StaticResource PanelBorderBrush}"
                                                    ToolTip="Save the title you typed in the box above"
                                                    AutomationProperties.AutomationId="RenameSessionButton"
                                                    AutomationProperties.Name="Rename session" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <Button Content="New"
                                        Command="{Binding Sessions.NewSessionCommand}"
                                        Padding="10,3"
                                        Background="{StaticResource ControlBrush}"
                                        Foreground="{StaticResource ForegroundBrush}"
                                        BorderBrush="{StaticResource PanelBorderBrush}"
                                        ToolTip="Start a new empty chat (nothing is saved until you send a message)"
                                        AutomationProperties.AutomationId="NewSessionButton"
                                        AutomationProperties.Name="New session" />
                                <!--
                                    DeleteCommand / SelectCommand 的参数得是 SessionItemViewModel，
                                    这里直接取 SessionList 上"被点中的那一行"（ElementName 绑的是控件本身，
                                    和 SelectedItem 的绑定方向无关）—— 所以删的永远是高亮的那一条。
                                    点列表本身就会切会话（见下面 SessionList_SelectionChanged），Open 只是兜底。
                                -->
                                <Button Content="Delete"
                                        Command="{Binding Sessions.DeleteCommand}"
                                        CommandParameter="{Binding SelectedItem, ElementName=SessionList}"
                                        Margin="6,0,0,0" Padding="10,3"
                                        Background="{StaticResource ControlBrush}"
                                        Foreground="{StaticResource ForegroundBrush}"
                                        BorderBrush="{StaticResource PanelBorderBrush}"
                                        ToolTip="Delete the selected session (cannot be undone)"
                                        AutomationProperties.AutomationId="DeleteSessionButton"
                                        AutomationProperties.Name="Delete selected session" />
                                <Button Content="Open"
                                        Command="{Binding Sessions.SelectCommand}"
                                        CommandParameter="{Binding SelectedItem, ElementName=SessionList}"
                                        Margin="6,0,0,0" Padding="10,3"
                                        Background="{StaticResource ControlBrush}"
                                        Foreground="{StaticResource ForegroundBrush}"
                                        BorderBrush="{StaticResource PanelBorderBrush}"
                                        ToolTip="Open the selected session"
                                        AutomationProperties.AutomationId="OpenSessionButton"
                                        AutomationProperties.Name="Open selected session" />
                            </StackPanel>
                            <TextBlock Text="{Binding Sessions.StatusMessage}"
                                       Foreground="{StaticResource MutedForegroundBrush}"
                                       FontSize="11"
                                       TextWrapping="Wrap"
                                       Margin="0,4,0,0"
                                       AutomationProperties.AutomationId="SessionStatusText"
                                       AutomationProperties.Name="Session status" />
                        </StackPanel>
                    </ScrollViewer>

                    <GridSplitter Grid.Column="1"
                                  Width="6"
                                  HorizontalAlignment="Stretch"
                                  VerticalAlignment="Stretch"
                                  Background="{StaticResource PanelBorderBrush}"
                                  AutomationProperties.AutomationId="ScaffoldSplitter"
                                  AutomationProperties.Name="Resize panel" />

                    <Grid Grid.Column="2" Margin="8,0,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                    <!--
                        三个开关：模型 / 推理等级 / 权限档位。
                        纯粹的 ComboBox：选中即生效，没有额外的按钮（模型旁边那个 ↻ 只是去拉列表），也没有任何样式 ——
                        视觉设计由 yancy 重画时随便改，绑定契约见 ChatViewModel 的类注释（三个都只是
                        ItemsSource + SelectedItem 双向绑定）。
                        想换成按钮、下拉、单选都行，ViewModel 那边一行都不用动。
                    -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,6">
                        <TextBlock Text="Model" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <ComboBox Width="220"
                                  ItemsSource="{Binding Models}"
                                  SelectedItem="{Binding SelectedModel, Mode=TwoWay}"
                                  Background="{StaticResource ControlBrush}"
                                  Foreground="{StaticResource ForegroundBrush}"
                                  BorderBrush="{StaticResource PanelBorderBrush}"
                                  ToolTip="The model name sent to the server. ↻ loads the list from GET /v1/models."
                                  AutomationProperties.AutomationId="ModelSelector"
                                  AutomationProperties.Name="Model" />
                        <Button Content="&#x21BB;"
                                Command="{Binding RefreshModelsCommand}"
                                Margin="6,0,0,0" Padding="8,3"
                                Background="{StaticResource ControlBrush}"
                                Foreground="{StaticResource ForegroundBrush}"
                                BorderBrush="{StaticResource PanelBorderBrush}"
                                ToolTip="Load the model list from the server"
                                AutomationProperties.AutomationId="RefreshModelsButton"
                                AutomationProperties.Name="Refresh model list" />

                        <TextBlock Text="Reasoning" VerticalAlignment="Center" Margin="16,0,6,0" />
                        <ComboBox Width="110"
                                  ItemsSource="{Binding ReasoningLevels}"
                                  SelectedItem="{Binding SelectedReasoning, Mode=TwoWay}"
                                  Background="{StaticResource ControlBrush}"
                                  Foreground="{StaticResource ForegroundBrush}"
                                  BorderBrush="{StaticResource PanelBorderBrush}"
                                  AutomationProperties.AutomationId="ReasoningSelector"
                                  AutomationProperties.Name="Reasoning effort" />

                        <TextBlock Text="Permissions" VerticalAlignment="Center" Margin="16,0,6,0" />
                        <ComboBox Width="130"
                                  ItemsSource="{Binding ApprovalModeLevels}"
                                  SelectedItem="{Binding SelectedApprovalMode, Mode=TwoWay}"
                                  Background="{StaticResource ControlBrush}"
                                  Foreground="{StaticResource ForegroundBrush}"
                                  BorderBrush="{StaticResource PanelBorderBrush}"
                                  ToolTip="Basic: every tool that touches this PC asks first. Advanced: only Dangerous tools ask."
                                  AutomationProperties.AutomationId="ApprovalModeSelector"
                                  AutomationProperties.Name="Permission mode" />
                    </StackPanel>

                    <!-- 当前生效的 provider（不含密钥） -->
                    <TextBlock Grid.Row="1"
                               Text="{Binding ProfileSummary}"
                               Margin="0,0,0,6"
                               AutomationProperties.AutomationId="ChatProfileText" />

                    <!--
                        消息列表：每行一条 ChatEntryViewModel。
                        正文交给 MarkdownViewer 渲染：它只负责"把 Markdown 画成富文本"，
                        字体 / 颜色 / 底色一律继承外层（控件本身一个颜色都不写），
                        所以你换主题时里面会自动跟着变。要改样子就改外层，或给它挂 Style。
                        IsStreaming 是流式开关：模型吐字期间它走纯文本快路径（不闪、不卡），
                        这一句说完变 false 才渲染成完整 Markdown —— 细节见 MarkdownViewer 的类注释。
                        AutomationProperties.Name 绑 DisplayText，是为了 UIA / 读屏还能拿到整行原文。

                        ⚠ HorizontalContentAlignment="Stretch" 不能删（实测）：ListBox 默认左对齐，
                          会用"无限宽"去量子项，而里面折行的 RichTextBox 在无限宽度下会退化成
                          10px 宽的一条缝（实测同一条消息：600 宽 → 行高 91px；无限宽 → 行高 671px、文字竖着折）。
                          写 Stretch 之后行宽 = 视口宽，行高回到 119.8px。这条有回归自测兜着。

                        ⚠ ScrollViewer.CanContentScroll="False" 不能删（实测，2026-09-21 滚动 bug 的根因）：
                          ListBox 默认是"按条滚动"，ExtentHeight 的单位是"条"，于是【一条比视口高的消息
                          永远滚不到它的底】—— 实测 600x200 的列表里放一条 1872px 高的 Markdown 回答，
                          滚到底之后它的底边还在视口下方 1871px，用户原话"markdown 渲染出来的东西滚动不到底部"。
                          关掉之后单位变像素：同一条消息滚到底时底边正好落在视口底（差 0px）。

                        md:ChatAutoScroll.IsEnabled="True" = 有新内容就自动跟到底（用户往上翻历史时不抢），
                          实现在 Markdown 层（src/Markdown/ChatAutoScroll.cs），不改这里的任何排版/配色。
                          它按"像素"判断贴不贴底，所以和上面那行 CanContentScroll="False" 是一对，别拆。
                    -->
                    <ListBox Grid.Row="2"
                             ItemsSource="{Binding Entries}"
                             HorizontalContentAlignment="Stretch"
                             ScrollViewer.CanContentScroll="False"
                             md:ChatAutoScroll.IsEnabled="True"
                             AutomationProperties.AutomationId="MessageList"
                             AutomationProperties.Name="Messages">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <md:MarkdownViewer Markdown="{Binding MarkdownText}"
                                                   IsStreaming="{Binding IsStreaming}"
                                                   AutomationProperties.Name="{Binding DisplayText}" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- 输入行 -->
                    <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,8,0,0">
                        <!-- 显式配色：不依赖主题，白底/深底都看得见（Fluent 主题下控件默认接近纯白） -->
                        <TextBox Width="620"
                                 Text="{Binding InputText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Background="{StaticResource ControlBrush}"
                                 Foreground="{StaticResource ForegroundBrush}"
                                 BorderBrush="{StaticResource PanelBorderBrush}"
                                 CaretBrush="{StaticResource ForegroundBrush}"
                                 Padding="6,4"
                                 AutomationProperties.AutomationId="ChatInputBox"
                                 AutomationProperties.Name="Chat input" />
                        <Button Content="Send"
                                Command="{Binding SendCommand}"
                                Margin="8,0,0,0" Padding="14,3"
                                Background="{StaticResource ControlBrush}"
                                Foreground="{StaticResource ForegroundBrush}"
                                BorderBrush="{StaticResource PanelBorderBrush}"
                                AutomationProperties.AutomationId="SendButton" />
                        <Button Content="Cancel"
                                Command="{Binding CancelCommand}"
                                Margin="6,0,0,0" Padding="14,3"
                                Background="{StaticResource ControlBrush}"
                                Foreground="{StaticResource ForegroundBrush}"
                                BorderBrush="{StaticResource PanelBorderBrush}"
                                AutomationProperties.AutomationId="CancelButton" />
                        <Button Content="Clear"
                                Command="{Binding ClearCommand}"
                                Margin="6,0,0,0" Padding="14,3"
                                Background="{StaticResource ControlBrush}"
                                Foreground="{StaticResource ForegroundBrush}"
                                BorderBrush="{StaticResource PanelBorderBrush}"
                                AutomationProperties.AutomationId="ClearButton" />
                    </StackPanel>

                    <!-- 状态行 + 已授权工具 -->
                    <StackPanel Grid.Row="4" Margin="0,8,0,0">
                        <TextBlock Text="{Binding StatusMessage}"
                                   TextWrapping="Wrap"
                                   AutomationProperties.AutomationId="ChatStatusText" />
                        <TextBlock Text="{Binding AlwaysAllowedText, StringFormat=Always allowed: {0}}"
                                   TextWrapping="Wrap"
                                   Margin="0,4,0,0"
                                   AutomationProperties.AutomationId="AlwaysAllowedText" />
                    </StackPanel>
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem Header="Control">
                <TextBlock Text="Control page - placeholder." Margin="12" />
            </TabItem>

            <TabItem Header="Files">
                <TextBlock Text="Files page - placeholder." Margin="12" />
            </TabItem>

            <TabItem Header="Tasks">
                <TextBlock Text="Tasks page - placeholder." Margin="12" />
            </TabItem>

            <TabItem Header="Memory">
                <TextBlock Text="Memory page - placeholder." Margin="12" />
            </TabItem>

            <TabItem Header="Board">
                <TextBlock Text="Board page - placeholder." Margin="12" />
            </TabItem>
        </TabControl>
    </Grid>
</Window>
