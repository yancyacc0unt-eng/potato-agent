<Window x:Class="GUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:GUI"
        mc:Ignorable="d"
        Title="potatoAgent"
        Height="640" Width="1000"
        MinHeight="480" MinWidth="760"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBackgroundBrush}"
        Foreground="{StaticResource ForegroundBrush}"
        FontFamily="Segoe UI" FontSize="13"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">
    <Grid Margin="16,12,16,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ==================== 顶栏：左边产品名，右上角齿轮按钮 ==================== -->
        <Grid Grid.Row="0" Margin="4,0,0,10">
            <TextBlock Text="potatoAgent"
                       Style="{StaticResource ProductTitleText}"
                       HorizontalAlignment="Left" />
            <!-- &#x2699; = gear，写成字符引用，XAML 文件保持纯 ASCII -->
            <Button x:Name="SettingsButton"
                    Content="&#x2699;"
                    Style="{StaticResource GearButtonStyle}"
                    HorizontalAlignment="Right"
                    ToolTip="Settings" />
        </Grid>

        <!-- ==================== 主区域：6 个页签 ==================== -->
        <Border Grid.Row="1"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource PanelBorderBrush}"
                BorderThickness="1"
                CornerRadius="6">
            <TabControl x:Name="MainTabs"
                        Background="Transparent"
                        BorderThickness="0"
                        Margin="8,8,8,0">
                <TabControl.Resources>
                    <!-- 内容区统一内边距 -->
                    <Style TargetType="TextBlock" x:Key="TabBodyText" BasedOn="{StaticResource PlaceholderText}">
                        <Setter Property="Margin" Value="16,18,16,16" />
                    </Style>
                </TabControl.Resources>

                <TabItem Header="Chat">
                    <TextBlock Style="{StaticResource TabBodyText}"
                               Text="Chat page placeholder - the conversation with the agent will live here." />
                </TabItem>

                <TabItem Header="Control">
                    <TextBlock Style="{StaticResource TabBodyText}"
                               Text="Control page placeholder - mouse, keyboard and window automation will live here." />
                </TabItem>

                <TabItem Header="Files">
                    <TextBlock Style="{StaticResource TabBodyText}"
                               Text="Files page placeholder - browsing and transferring files will live here." />
                </TabItem>

                <TabItem Header="Tasks">
                    <TextBlock Style="{StaticResource TabBodyText}"
                               Text="Tasks page placeholder - scheduled and running tasks will live here." />
                </TabItem>

                <TabItem Header="Memory">
                    <TextBlock Style="{StaticResource TabBodyText}"
                               Text="Memory page placeholder - long term memory entries will live here." />
                </TabItem>

                <TabItem Header="Board">
                    <TextBlock Style="{StaticResource TabBodyText}"
                               Text="Board page placeholder - kanban style notes will live here." />
                </TabItem>
            </TabControl>
        </Border>
    </Grid>
</Window>
