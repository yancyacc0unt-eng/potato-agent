<Window x:Class="GUI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:GUI"
        mc:Ignorable="d"
        Title="Settings"
        Height="620" Width="780"
        MinHeight="420" MinWidth="620"
        WindowStartupLocation="CenterOwner">

    <!--
        ============================================================================
        设置页（临时脚手架，可以整个删掉重画）
        ============================================================================
        DataContext = GUI.ViewModels.SettingsViewModel（由 MainWindow 挂上）。
        每一行都是 label + 控件，全部走 {Binding}；这里的逻辑为零。

        唯一的代码挂钩：密码框 PasswordChanged="ApiKeyBox_PasswordChanged"
        （WPF 的 PasswordBox.Password 不可绑定，必须用事件把值推给 ViewModel）。
    -->
    <Window.Resources>
        <Style TargetType="TextBlock" x:Key="FieldLabel">
            <Setter Property="Margin" Value="0,0,10,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" MinWidth="110" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- ===== 档案 ===== -->
            <TextBlock Grid.Row="0" Grid.Column="0" Text="Profile" Style="{StaticResource FieldLabel}" VerticalAlignment="Top" Margin="0,4,10,0" />
            <ListBox Grid.Row="0" Grid.Column="1"
                     Height="72"
                     ItemsSource="{Binding Profiles}"
                     SelectedItem="{Binding SelectedProfileName, Mode=TwoWay}"
                     AutomationProperties.AutomationId="ProfileList"
                     AutomationProperties.Name="Profiles" />

            <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,6,0,0">
                <Button Content="Load from disk" Command="{Binding LoadCommand}" Padding="10,2"
                        AutomationProperties.AutomationId="LoadButton" />
                <Button Content="New profile" Command="{Binding NewProfileCommand}" Padding="10,2" Margin="6,0,0,0"
                        AutomationProperties.AutomationId="NewProfileButton" />
                <Button Content="Delete profile" Command="{Binding DeleteProfileCommand}" Padding="10,2" Margin="6,0,0,0"
                        AutomationProperties.AutomationId="DeleteProfileButton" />
            </StackPanel>

            <!-- ===== 档案名 ===== -->
            <TextBlock Grid.Row="2" Grid.Column="0" Text="Profile name" Style="{StaticResource FieldLabel}" />
            <TextBox Grid.Row="2" Grid.Column="1" Margin="0,4,0,0"
                     Text="{Binding ProfileName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     AutomationProperties.AutomationId="ProfileNameBox"
                     AutomationProperties.Name="Profile name" />

            <!-- ===== Base URL ===== -->
            <TextBlock Grid.Row="3" Grid.Column="0" Text="Base URL" Style="{StaticResource FieldLabel}" Margin="0,10,10,0" />
            <TextBox Grid.Row="3" Grid.Column="1" Margin="0,10,0,0"
                     Text="{Binding BaseUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     AutomationProperties.AutomationId="BaseUrlBox"
                     AutomationProperties.Name="Base URL" />

            <TextBlock Grid.Row="4" Grid.Column="1" Margin="0,4,0,0" TextWrapping="Wrap"
                       Text="{Binding EndpointPreview}"
                       AutomationProperties.AutomationId="EndpointText" />

            <!-- ===== API key ===== -->
            <TextBlock Grid.Row="5" Grid.Column="0" Text="API key" Style="{StaticResource FieldLabel}" Margin="0,12,10,0" />
            <PasswordBox Grid.Row="5" Grid.Column="1" x:Name="ApiKeyBox" Margin="0,12,0,0"
                         PasswordChanged="ApiKeyBox_PasswordChanged"
                         AutomationProperties.AutomationId="ApiKeyBox"
                         AutomationProperties.Name="API key" />

            <StackPanel Grid.Row="6" Grid.Column="1" Orientation="Horizontal" Margin="0,4,0,0">
                <TextBlock Text="{Binding ApiKeyMasked}"
                           VerticalAlignment="Center"
                           AutomationProperties.AutomationId="ApiKeyStateText" />
                <Button Content="Clear stored key" Command="{Binding ClearApiKeyCommand}" Padding="10,2" Margin="10,0,0,0"
                        AutomationProperties.AutomationId="ClearApiKeyButton" />
            </StackPanel>

            <!-- ===== 模型 ===== -->
            <TextBlock Grid.Row="7" Grid.Column="0" Text="Model" Style="{StaticResource FieldLabel}" Margin="0,12,10,0" />
            <TextBox Grid.Row="7" Grid.Column="1" Margin="0,12,0,0"
                     Text="{Binding Model, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     AutomationProperties.AutomationId="ModelBox"
                     AutomationProperties.Name="Model" />

            <TextBlock Grid.Row="8" Grid.Column="0" Text="Models found" Style="{StaticResource FieldLabel}" VerticalAlignment="Top" Margin="0,6,10,0" />
            <ListBox Grid.Row="8" Grid.Column="1" Height="60" Margin="0,6,0,0"
                     ItemsSource="{Binding AvailableModels}"
                     SelectedItem="{Binding SelectedModelSuggestion, Mode=TwoWay}"
                     AutomationProperties.AutomationId="ModelList"
                     AutomationProperties.Name="Models found by the connection test" />

            <!-- ===== 采样参数 ===== -->
            <TextBlock Grid.Row="9" Grid.Column="0" Text="Temperature" Style="{StaticResource FieldLabel}" Margin="0,10,10,0" />
            <TextBox Grid.Row="9" Grid.Column="1" Margin="0,10,0,0"
                     Text="{Binding TemperatureText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     AutomationProperties.AutomationId="TemperatureBox"
                     AutomationProperties.Name="Temperature" />

            <TextBlock Grid.Row="10" Grid.Column="0" Text="Max tokens" Style="{StaticResource FieldLabel}" Margin="0,8,10,0" />
            <TextBox Grid.Row="10" Grid.Column="1" Margin="0,8,0,0"
                     Text="{Binding MaxTokensText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     AutomationProperties.AutomationId="MaxTokensBox"
                     AutomationProperties.Name="Max tokens" />

            <!-- ===== 动作 ===== -->
            <StackPanel Grid.Row="11" Grid.Column="1" Orientation="Horizontal" Margin="0,16,0,0">
                <Button Content="Save" Command="{Binding SaveCommand}" Padding="18,4"
                        AutomationProperties.AutomationId="SaveButton" />
                <Button Content="Test connection" Command="{Binding TestConnectionCommand}" Padding="18,4" Margin="8,0,0,0"
                        AutomationProperties.AutomationId="TestConnectionButton" />
                <Button Content="Close" IsCancel="True" Padding="18,4" Margin="8,0,0,0"
                        AutomationProperties.AutomationId="CloseSettingsButton" />
            </StackPanel>

            <!-- ===== 状态 ===== -->
            <TextBlock Grid.Row="12" Grid.Column="1" Margin="0,14,0,0" TextWrapping="Wrap"
                       Text="{Binding StatusMessage}"
                       AutomationProperties.AutomationId="SettingsStatusText" />

            <TextBlock Grid.Row="13" Grid.Column="1" Margin="0,6,0,0" TextWrapping="Wrap"
                       Text="{Binding ConfigFilePath, StringFormat=Config file: {0}}"
                       AutomationProperties.AutomationId="ConfigPathText" />
        </Grid>
    </ScrollViewer>
</Window>
