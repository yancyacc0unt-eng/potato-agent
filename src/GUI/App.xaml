<Application x:Class="GUI.App"
             ThemeMode="System"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:GUI">
    <!--
        没有 StartupUri：主窗口由 App.xaml.cs 的 OnStartup 显式建（那里是唯一的装配点，
        ViewModel / ConfigStore / ToolRegistry 都在同一段里接起来）。
    -->
    <Application.Resources>

        <!--
            深色主题调色板 + 通用控件样式。当前临时脚手架界面并没有引用它们
            （MainWindow.xaml 顶部的两条空 Style 会把页签样式清回默认外观）；
            正式界面由 yancy 亲自设计，这套留着备用，可以随手改或整个删掉。
        -->

        <!--
            深色主题：整个应用共用一套调色板 + 控件样式。
            只放"通用"的东西，页面级布局留给各自的 XAML。
            颜色都写成 #AARRGGBB，方便直接复制微调。
        -->

        <!-- ==================== 调色板 ==================== -->
        <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#FF16161A" />
        <SolidColorBrush x:Key="SurfaceBrush"         Color="#FF1E1E24" />
        <SolidColorBrush x:Key="ControlBrush"         Color="#FF2A2A33" />
        <SolidColorBrush x:Key="HoverBrush"           Color="#FF35353F" />
        <SolidColorBrush x:Key="PanelBorderBrush"     Color="#FF33333D" />
        <SolidColorBrush x:Key="ForegroundBrush"      Color="#FFE9E9EF" />
        <SolidColorBrush x:Key="MutedForegroundBrush" Color="#FF9A9AA8" />
        <SolidColorBrush x:Key="AccentBrush"          Color="#FF4C9AFF" />

        <!-- ==================== 文字样式 ==================== -->

        <!-- 页面里的占位正文 -->
        <Style x:Key="PlaceholderText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="{StaticResource MutedForegroundBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <!-- 左上角产品名 -->
        <Style x:Key="ProductTitleText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource ForegroundBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- ==================== 页签样式 ==================== -->

        <!-- TabControl 本体：把内容区刷成深灰面板色 -->
        <Style TargetType="TabControl">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource PanelBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="0" />
        </Style>

        <!-- TabItem：未选中 = 暗字 + 透明底；选中 = 亮字 + 深灰底 + 蓝色下划线 -->
        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="{StaticResource MutedForegroundBrush}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="16,8" />
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabRoot"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="0,0,0,2"
                                CornerRadius="6,6,0,0"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter x:Name="TabHeader"
                                              ContentSource="Header"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabRoot" Property="Background" Value="{StaticResource HoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabRoot" Property="Background" Value="{StaticResource SurfaceBrush}" />
                                <Setter TargetName="TabRoot" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource ForegroundBrush}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ==================== 按钮样式 ==================== -->

        <!-- 右上角齿轮按钮：圆形扁平，悬停变亮 -->
        <Style x:Key="GearButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Foreground" Value="{StaticResource MutedForegroundBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonRoot"
                                Background="{TemplateBinding Background}"
                                CornerRadius="16">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonRoot" Property="Background" Value="{StaticResource HoverBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource ForegroundBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonRoot" Property="Background" Value="{StaticResource ControlBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 深色 ToolTip，避免悬停时弹出白色方块 -->
        <Style TargetType="ToolTip">
            <Setter Property="Background" Value="{StaticResource ControlBrush}" />
            <Setter Property="Foreground" Value="{StaticResource ForegroundBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource PanelBorderBrush}" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="FontSize" Value="12" />
        </Style>

    </Application.Resources>
</Application>
