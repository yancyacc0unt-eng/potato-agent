<Project>

  <!--
    工作区系统的自测。规矩照抄 CoreSelfTest.csproj：
    csproj 住 build/、源码住 src/WorkspacesSelfTest/、显式 Include、单独开 obj/bin 子目录。

    它【不在】build.slnx 里，build.bat 也不会碰它，只有想复跑自测时才手动：
      dotnet run -p build\WorkspacesSelfTest.csproj -c Debug
      （XML 注释里不能出现连续两个减号，所以这里用 -p 而不是长开关形式。）
    退出码 0 = 全部通过，1 = 有失败（见 Program.cs）。

    ⚠ 自测只写临时目录：绝不读也不写 %APPDATA%\PotatoAgent，绝不碰用户真实工作区。
  -->

  <PropertyGroup>
    <BaseIntermediateOutputPath>obj\WorkspacesSelfTest\</BaseIntermediateOutputPath>
    <BaseOutputPath>bin\WorkspacesSelfTest\</BaseOutputPath>
  </PropertyGroup>

  <Import Project="Sdk.props" Sdk="Microsoft.NET.Sdk" />

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <AssemblyName>WorkspacesSelfTest</AssemblyName>
    <RootNamespace>PotatoAgent.Workspaces.SelfTest</RootNamespace>

    <EnableDefaultItems>false</EnableDefaultItems>
    <SynthesizeLinkMetadata>true</SynthesizeLinkMetadata>
    <DefaultItemExcludes>$(DefaultItemExcludes);.vs\**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\src\WorkspacesSelfTest\**\*.cs" Exclude="..\src\WorkspacesSelfTest\obj\**;..\src\WorkspacesSelfTest\bin\**" LinkBase="src\WorkspacesSelfTest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="Workspaces.csproj" />
  </ItemGroup>

  <Import Project="Sdk.targets" Sdk="Microsoft.NET.Sdk" />

</Project>
