<Project>

  <!--
    AgentSession + pc_* 工具的实机自测。规矩照抄 Win32SelfTest.csproj：
    csproj 住 build/、源码住 src/AgentSelfTest/、显式 Include、单独开 obj/bin 子目录
    （同一个目录下的多个项目会互相覆盖 project.assets.json）。

    它【不在】build.slnx 里，build.bat 也不会碰它 —— 只有想复跑实测时才手动：
      dotnet build build\AgentSelfTest.csproj -c Debug
      build\bin\AgentSelfTest\Debug\net10.0-windows\AgentSelfTest.exe

    ⚠ 会真的截图、真的起一个记事本并只对它注入输入（全程过焦点门禁），跑完自动关掉。
    ⚠ 全程不连外网：模型侧一律用 127.0.0.1 上的假服务端。
  -->

  <PropertyGroup>
    <BaseIntermediateOutputPath>obj\AgentSelfTest\</BaseIntermediateOutputPath>
    <BaseOutputPath>bin\AgentSelfTest\</BaseOutputPath>
  </PropertyGroup>

  <Import Project="Sdk.props" Sdk="Microsoft.NET.Sdk" />

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <AssemblyName>AgentSelfTest</AssemblyName>
    <RootNamespace>PotatoAgent.Agent.SelfTest</RootNamespace>

    <EnableDefaultItems>false</EnableDefaultItems>
    <SynthesizeLinkMetadata>true</SynthesizeLinkMetadata>
    <DefaultItemExcludes>$(DefaultItemExcludes);.vs\**</DefaultItemExcludes>

    <!-- 自测要独立解码截图（System.Drawing）并独立读回记事本内容（UIA），所以同样开 WPF/WinForms -->
    <UseWindowsForms>true</UseWindowsForms>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\src\AgentSelfTest\**\*.cs" Exclude="..\src\AgentSelfTest\obj\**;..\src\AgentSelfTest\bin\**" LinkBase="src\AgentSelfTest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="Core.csproj" />
    <ProjectReference Include="Win32.csproj" />
  </ItemGroup>

  <Import Project="Sdk.targets" Sdk="Microsoft.NET.Sdk" />

</Project>
